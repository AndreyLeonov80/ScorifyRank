    "audit:dashboard-first-render": "node scripts/audit-dashboard-first-render.mjs",
    "audit:dashboard-lean": "node scripts/audit-dashboard-lean.mjs",
    "audit:grid-source-stats": "node scripts/audit-grid-source-stats-unified.mjs",
